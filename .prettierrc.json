{
	"$schema": "https://json.schemastore.org/prettierrc",
	"semi": true,
	"singleQuote": true,
	"printWidth": 100,
	"tabWidth": 4,
	"useTabs": true,
	"overrides": [
		{
			"files": ["*.ts", "*.tsx", "*.vue"],
			"options": {
				"bracketSpacing": true,
				"singleAttributePerLine": false,
				"jsxBracketSameLine": false,
				"arrowParens": "always"
			}
		}
	]
}
